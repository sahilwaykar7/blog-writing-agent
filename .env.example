# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required: LLM (OpenAI) – used for planning and writing
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: web research (Tavily)
# TAVILY_API_KEY=tvly-your-tavily-api-key

# OpenAI is used for both text and images by default.
# Optional: Gemini fallback for image generation if OpenAI image generation fails.
# GOOGLE_API_KEY=your-google-api-key

# Optional: Publish generated blogs to Dev.to and Medium (see README).
# DEVTO_API_KEY=your-devto-api-key
# MEDIUM_INTEGRATION_TOKEN=your-medium-integration-token

# Optional: public image URLs for publish (upload local images/ to Cloudinary before Dev.to/Medium).
# Get credentials from https://cloudinary.com/console — Dashboard shows CLOUDINARY_URL or cloud name + key + secret.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or: CLOUDINARY_CLOUD_NAME=xxx  CLOUDINARY_API_KEY=xxx  CLOUDINARY_API_SECRET=xxx
# Optional folder prefix for uploads: CLOUDINARY_FOLDER=blog-writing-agent
