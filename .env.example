# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required: LLM (OpenAI) – used for planning and writing
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: web research (Tavily)
# TAVILY_API_KEY=tvly-your-tavily-api-key

# OpenAI is used for both text and images by default.
# Optional: Gemini fallback for image generation if OpenAI image generation fails.
# GOOGLE_API_KEY=your-google-api-key

# Optional: Publish generated blogs to Dev.to and Medium (see README).
# DEVTO_API_KEY=your-devto-api-key
# MEDIUM_INTEGRATION_TOKEN=your-medium-integration-token
